# Google Gemini API Key for LLM Agent
GEMINI_API_KEY=your_gemini_api_key_here

# Django Secret Key (Generate a random secure key for production)
SECRET_KEY=django-insecure-change-this-in-production-key-12345

# Debug Mode (True for development, False for production)
DEBUG=True

# Allowed Hosts (Comma-separated hostnames or IP addresses)
ALLOWED_HOSTS=*

# Neon PostgreSQL Database URL (from neon.tech dashboard)
# Example: postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
